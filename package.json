{
  "name": "pilote-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --dir src",
    "test:integration": "vitest run --dir tests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verifier-le-code": "eslint src",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "secretlint --secretlintignore .secretlintignore src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "secretlint": "^13.0.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
